[resource]
script = ExtResource("2_eninf")
lines = "OHHHHHHHHHHHHHHHHHHHHHHHHHH okay. It seems like this machine runs on... an unsigned 64-bit system..... Lemme just run those calculations......
Hm. 2 raised to the 64th seconds is approximately... 585 billion years. The Sun died approximately 580 billion years ago. Well, it seems that your spinning hasn’t stopped. We must venture onwards to return to your time!"
